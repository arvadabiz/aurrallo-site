# ── Supabase (client-side, safe to be public) ────────────
# Copy to .env.local and fill in real values.
# .env.local is gitignored — never commit real keys.

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── Resend (server-side ONLY — never put this in .env.local) ──
# This key goes in Supabase as a secret, NOT in this file.
# Run:  supabase secrets set RESEND_API_KEY=re_xxxxxxxxxxxx
# The send-welcome edge function reads it via Deno.env.get("RESEND_API_KEY")
#
# RESEND_API_KEY=re_xxxxxxxxxxxx   ← DO NOT uncomment, use supabase secrets set
